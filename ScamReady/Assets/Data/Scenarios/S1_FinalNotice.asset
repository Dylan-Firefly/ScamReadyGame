%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1c517d12e53a1764d85a68cd927de021, type: 3}
  m_Name: S1_FinalNotice
  m_EditorClassIdentifier: Assembly-CSharp::ScamReady.Scenarios.EmailScenarioDefinition
  id: S1_FinalNotice
  title: Final Notice
  setup: You know your tuition payment is coming up, but you are unsure of the due
    date. Check your email and decide how to respond.
  gameDateText: 5 October  |  10:17 AM
  email:
    id: S1_InitialEmail
    sender: University Student Fees
    from: studentfees@university.edu.au
    replyTo: payment.support@university-fees.com.au
    subject: FINAL NOTICE - Outstanding Tuition Fee
    body: 'Dear Student,


      Our records indicate that an outstanding tuition
      balance of AUD 4,820.00 remains unpaid on your student account.


      Your
      payment was due on 3 October.


      To prevent a temporary restriction being
      placed on your enrolment and further review of your student record, payment
      must be arranged before 3:00 PM today.


      Due to an issue with the online
      student payment system, this outstanding balance cannot currently be processed
      through the Student Portal.


      Please reply to this email with your Student
      ID and quote Case ID UFS-20481. Our payment team will provide alternative payment
      instructions.


      Failure to respond before the deadline may result in
      further administrative action.


      Regards,

      Student Fees and Payments

      University
      Administration'
    proceedLabel: Trust the request and pay
    stopContactLabel: Return to desktop and verify
    ignoreLabel: Leave the email unanswered
    rejectLabel: Reject / report this email
  verificationPages:
  - {fileID: 11400000, guid: 0fb44e770c7b4fcf984b1d96e4550a5d, type: 2}
  - {fileID: 11400000, guid: d302f4413e4f4c4d8532b9cba9f4c2e4, type: 2}
  evidencePlacements:
  - page: {fileID: 11400000, guid: 0fb44e770c7b4fcf984b1d96e4550a5d, type: 2}
    evidence: {fileID: 11400000, guid: c702b85d5c1c4effb5d6ffdc38d9823d, type: 2}
    content: "Tuition fee: AUD 4,820.00\nDue date: 12 October\nStatus: Payment Pending\nOverdue: No"
  - page: {fileID: 11400000, guid: d302f4413e4f4c4d8532b9cba9f4c2e4, type: 2}
    evidence: {fileID: 11400000, guid: ce72c006f5384efa92ee6d4367b227f7, type: 2}
    content: "Check the balance and due date in your Student Portal. Use the official portal payment options. The payment service is available."
  requiredEvidence:
  - {fileID: 11400000, guid: c702b85d5c1c4effb5d6ffdc38d9823d, type: 2}
  - {fileID: 11400000, guid: ce72c006f5384efa92ee6d4367b227f7, type: 2}
  reminder:
    id: S1_P01_FINAL_REMINDER
    triggerEvidenceCount: 1
    title: FINAL REMINDER
    body: "Your case remains unresolved. Payment arrangements must be made before 3:00 PM today to avoid further administrative action."
  feedback:
    proceed:
      title: You paid the scammer
      body: "You believed the sender's claim and followed the alternative payment instructions. Your money went to a scammer.\n\nThe official tuition record says the payment is due on 12 October and is not overdue. Payments should use the official Student Portal. Following this email's instructions did not settle your real tuition balance."
    ignore:
      title: You ignored the message
      body: "You ignored the suspicious email and did not pay the sender. But was ignoring it the best response?\n\nYour real tuition balance still needs attention. Use the official Student Portal to confirm the due date and payment process. Ignoring the email does not resolve that obligation."
    reportUnverified:
      title: Safe, but without supporting evidence
      body: "You rejected the suspicious email and avoided paying the scammer. You did not collect evidence before making this decision.\n\nYou are safe from this payment request, but your decision lacks a recorded basis. Check claims through trusted official sources. Your real tuition obligation remains separate from this email."
    reportPartial:
      title: Safe, with some verification
      body: "You rejected the email after collecting {evidenceCount} evidence item(s), including {collectedRequiredCount} of the {requiredCount} required items. You avoided paying the scammer.\n\nYour checks support caution, but you have not collected all the key evidence. Compare both the official tuition record and payment procedure to reach a better supported decision. Your real tuition obligation still needs official handling."
    reportVerified:
      title: Safe, with a supported decision
      body: "You collected {evidenceCount} evidence item(s), including all {requiredCount} required items, before rejecting the email. The official due date and payment procedure contradict the sender's claims, giving you a strong basis to identify the scam.\n\nYou avoided paying the scammer. Your real tuition obligation still needs to be handled through the official Student Portal."
