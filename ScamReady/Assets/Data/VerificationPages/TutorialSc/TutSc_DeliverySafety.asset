  m_Name: TutSc_DeliverySafety
  m_EditorClassIdentifier: Assembly-CSharp::ScamReady.Verification.VerificationPageDefinition
  id: "HARBOUR_PAGE_DELIVERY_SAFETY"
  entryLabel: "Harbour Parcel Delivery Safety"
  siteName: "Harbour Parcel - Official Website"
  address: "https://harbourparcel.example/help/delivery-safety"
  title: "Recognising Fake Delivery Requests"
  body: "Check delivery updates through Harbour Parcel's official website or app. Open these independently rather than following a link in an unexpected message.\n\nOur payment and card-information policy is shown below.\n\nA familiar sender name, company logo or tracking number does not prove that a message is genuine. If you are unsure about a delivery request, use Help and Contact on our official website."
