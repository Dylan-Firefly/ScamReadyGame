  m_Name: S2_AccountSecurityGuide
  m_EditorClassIdentifier: Assembly-CSharp::ScamReady.Verification.VerificationPageDefinition
  id: "S2_PAGE_ACCOUNT_SECURITY_GUIDE"
  entryLabel: "IT Account Security"
  siteName: "Harbour University - IT Services"
  address: "https://www.harbouruniversity.example/it/account-security"
  title: "Checking Account Notices"
  body: "The university may send genuine password-expiry reminders. An email reminder alone does not establish whether a request is genuine.\n\nFor Harbour University account checks and password changes, open the university website independently and use Student Account Centre:\nhttps://accounts.harbouruniversity.example/student\n\nOur account-management service uses accounts.harbouruniversity.example. Check the actual website address before entering your password; a similar-looking name on another domain is not this service. IT staff will not ask you to send your password in an email reply."
  isUnsafe: 0
  processLabel: "Process"
