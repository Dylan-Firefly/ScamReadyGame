  m_Script: {fileID: 11500000, guid: 3ce98cae6db03ce47aba606ce2c97e07, type: 3}
  m_Name: S4_LibraryRecallPolicy
  m_EditorClassIdentifier: Assembly-CSharp::ScamReady.Verification.VerificationPageDefinition
  id: "S4_PAGE_LIBRARY_RECALL_POLICY"
  entryLabel: "Library Recall Policy"
  siteName: "Harbour University Library"
  address: "https://library.harbouruniversity.example/borrowing/recalls"
  title: "Recalls, Returns and Overdue Items"
  body: "A recall can shorten the due date of a book you have borrowed. A notice is sent to your university email, and the new date is shown in My Library Loans. Recalled items cannot be renewed.\n\nAt Harbour University, recalled books returned after the new due date incur AUD 2 per overdue day, up to AUD 30. Borrowing is paused while an overdue item remains unreturned. Once it is returned, fines below AUD 20 do not prevent further borrowing.\n\nReturn books using the library return chute or service desk. This notice does not require a payment by email. Check your own loan record:\nhttps://library.harbouruniversity.example/account/loans"
  isUnsafe: 0
  processLabel: "Process"
