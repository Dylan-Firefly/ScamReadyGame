  m_Script: {fileID: 11500000, guid: 3ce98cae6db03ce47aba606ce2c97e07, type: 3}
  m_Name: S5_OfficialPaymentPolicy
  m_EditorClassIdentifier: Assembly-CSharp::ScamReady.Verification.VerificationPageDefinition
  id: "S5_PAGE_OFFICIAL_PAYMENT_POLICY"
  entryLabel: "Fees and Payment Policy"
  siteName: "Harbour University - Fees and Payments"
  address: "https://www.harbouruniversity.example/students/fees/payment-policy"
  title: "Paying Your Tuition Balance"
  body: "Tuition payments are made through the payment options available in the official Student Portal. The service is available. Check the invoice reference, balance, due date and any recent payments before paying.\n\nFor invoice HU-TF1042, payment is due on 12 October. If the balance remains unpaid, a one-off AUD 75 late-payment fee is applied on 15 October. The original tuition balance remains payable.\n\nA reminder may arrive after a recent payment. Check received payments and contact Fees and Payments through the university website if a payment is missing. Do not pay the same balance twice. If you cannot pay on time, contact the team before the due date to discuss available support.\n\nStudent account:\nhttps://students.harbouruniversity.example/finances/tuition"
  isUnsafe: 0
  processLabel: "Process"
